# Configuración opcional. ./iniciar.sh crea el .env automáticamente a partir de este archivo.
# (el .env NO se sube a GitHub). No hay rutas que configurar: cada archivo se guarda
# donde tú elijas con "Guardar como" en la web.

# Puerto local (solo accesible desde 127.0.0.1)
PORT=5050

# Horas que los archivos quedan disponibles en la web antes de borrarse solos
FILE_TTL_HOURS=3

# (Opcional) Usar la imagen YA publicada, probada y firmada por el pipeline,
# en vez de construirla en tu PC (arranca mucho más rápido). Descomenta:
# IMAGE=ghcr.io/diriartev/ivnonym-downloader:latest
